    imageUrl: 'https://images.unsplash.com/photo-1554415707-6e8cfc93fe23?auto=format&fit=crop&w=600&q=80'
  }
];

const CATEGORY_COLORS = {
  'Barangan Dapur': '#3b82f6',
  'Petrol & Pengangkutan': '#f59e0b',
  'Makanan & Minuman': '#10b981',
  'Beli-belah': '#ec4899',
  'Lain-lain': '#64748b'
};

const GOOGLE_APPS_SCRIPT_CODE = `/**
 * GOOGLE APPS SCRIPT BACKEND SETUP
 * Paste kod ini ke dalam Google Apps Script project.
 */
function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    
    // Simpan Fail Gambar ke Google Drive
    var folderId = "MASUKKAN_FOLDER_ID_DRIVE_ANDA"; 
    var folder = DriveApp.getFolderById(folderId);
    
    var base64Parts = data.imageBase64.split(",");
    var contentType = base64Parts[0].match(/:(.*?);/)[1];
    var decodedData = Utilities.base64Decode(base64Parts[1]);
    
    var fileName = "Resit_" + (data.id || new Date().getTime()) + ".jpg";
    var blob = Utilities.newBlob(decodedData, contentType, fileName);
    var file = folder.createFile(blob);
    
    file.setSharing(DriveApp.Access.ANYONE_WITH_LINK, DriveApp.Permission.VIEW);
    var driveFileUrl = file.getUrl();

    // Tambah Data ke Baris Google Sheet
    sheet.appendRow([
      data.id || "REC-" + new Date().getTime(),
      data.store,
      data.date,
      data.time,
      parseFloat(data.amount),
      data.category,
      driveFileUrl,
      "Disahkan oleh AI"
    ]);

    return ContentService.createTextOutput(JSON.stringify({ status: "success", driveUrl: driveFileUrl })).setMimeType(ContentService.MimeType.JSON);
  } catch (err) {
    return ContentService.createTextOutput(JSON.stringify({ status: "error", message: err.toString() })).setMimeType(ContentService.MimeType.JSON);
  }
}`;

export default function App() {
  const [activeTab, setActiveTab] = useState('upload');
  const [receipts, setReceipts] = useState(INITIAL_RECEIPTS);
  const [selectedFile, setSelectedFile] = useState(null);
  const [previewUrl, setPreviewUrl] = useState(null);
  const [imageBase64, setImageBase64] = useState(null);
  const [isScanning, setIsScanning] = useState(false);
  const [extractedData, setExtractedData] = useState(null);
  const [isSubmitting, setIsSubmitting] = useState(false);
  const [uploadSuccessMsg, setUploadSuccessMsg] = useState('');
  const [scriptUrl, setScriptUrl] = useState('');
  const [searchTerm, setSearchTerm] = useState('');
  const [timeFilter, setTimeFilter] = useState('semua'); // TAMBAH PENAPIS MASA
  const [selectedReceiptDetail, setSelectedReceiptDetail] = useState(null);

  // --- HANDLERS ---
  const handleFileChange = (file) => {
    if (!file) return;
    if (!file.type.startsWith('image/')) {
      alert('Sila pilih fail gambar resit sahaja (JPG, PNG, WebP).');
      return;
    }
    setSelectedFile(file);
    
    const reader = new FileReader();
    reader.onloadend = () => {
      setPreviewUrl(reader.result);
      setImageBase64(reader.result);
    };
    reader.readAsDataURL(file);

    setExtractedData(null);
    setUploadSuccessMsg('');
    triggerAIScan();
  };

  const triggerAIScan = () => {
    setIsScanning(true);
    setTimeout(() => {
      setExtractedData({
        store: "Jaya Grocer (Simulasi)",
        date: new Date().toISOString().split('T')[0],
        time: new Date().toLocaleTimeString('en-MY', { hour12: false }).substring(0, 5),
        amount: (Math.random() * 100 + 20).toFixed(2),
        category: 'Barangan Dapur',
        aiConfidence: 96
      });
      setIsScanning(false);
    }, 2000);
  };

  const handleSaveReceipt = async (e) => {
    e.preventDefault();
    if (!extractedData) return;

    setIsSubmitting(true);

    const newReceipt = {
      id: `REC-${new Date().getFullYear()}-${Math.floor(100 + Math.random() * 900)}`,
      store: extractedData.store,
      date: extractedData.date,
      time: extractedData.time,
      amount: parseFloat(extractedData.amount),
      category: extractedData.category,
      driveUrl: 'https://drive.google.com',
      imageUrl: previewUrl || 'https://images.unsplash.com/photo-1554415707-6e8cfc93fe23?auto=format&fit=crop&w=600&q=80',
      imageBase64: imageBase64,
      status: 'Disahkan',
      aiConfidence: extractedData.aiConfidence || 98
    };

    if (scriptUrl) {
      try {
        await fetch(scriptUrl, {
          method: 'POST',
          mode: 'no-cors',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(newReceipt)
        });
      } catch (err) {
        console.error("Ralat hantar ke Apps Script:", err);
      }
    }

    setReceipts([newReceipt, ...receipts]);
    setIsSubmitting(false);
    setUploadSuccessMsg('Resit & Gambar Pembuktian berjaya disimpan!');
    
    setTimeout(() => {
      setSelectedFile(null);
      setPreviewUrl(null);
      setImageBase64(null);
      setExtractedData(null);
      setActiveTab('list');
    }, 1500);
  };

  // --- STATS & CHARTS COMPUTATION ---
  const today = new Date('2026-11-20'); // Tarikh semasa sistem
  
  const filteredReceipts = receipts.filter(r => {
    // 1. Carian Teks (Nama kedai atau Kategori)
    const matchSearch = r.store.toLowerCase().includes(searchTerm.toLowerCase()) ||
                        r.category.toLowerCase().includes(searchTerm.toLowerCase());
    
    // 2. Tapisan Masa
    const rDate = new Date(r.date);
    let matchTime = true;
    
    if (timeFilter === 'harian') {
      matchTime = r.date === '2026-11-20';
    } else if (timeFilter === 'mingguan') {
      const diffDays = Math.ceil(Math.abs(today - rDate) / (1000 * 60 * 60 * 24)); 
      matchTime = diffDays <= 7;
    } else if (timeFilter === 'bulanan') {
      matchTime = rDate.getMonth() === today.getMonth() && rDate.getFullYear() === today.getFullYear();
    } else if (timeFilter === 'tahunan') {
      matchTime = rDate.getFullYear() === today.getFullYear();
    }
    
    return matchSearch && matchTime;
  });

  const totalAmount = filteredReceipts.reduce((sum, r) => sum + r.amount, 0);
  
  const categoryTotals = filteredReceipts.reduce((acc, r) => {
    acc[r.category] = (acc[r.category] || 0) + r.amount;
    return acc;
  }, {});
  
  const pieData = Object.entries(categoryTotals).map(([name, value]) => ({ name, value }));

  // --- EXPORT FUNCTION ---
  const handleExportCSV = () => {
    if (filteredReceipts.length === 0) {
      alert("Tiada data untuk dieksport.");
      return;
    }

    const headers = ['ID Resit', 'Kedai', 'Tarikh', 'Waktu', 'Kategori', 'Jumlah (RM)', 'Status', 'Keyakinan AI (%)'];
    
    const csvRows = [headers.join(',')];
    
    filteredReceipts.forEach(r => {
      const row = [
        r.id,
        `"${r.store}"`, // "Escape" nama kedai jika ada koma
        r.date,
        r.time,
        `"${r.category}"`,
        r.amount.toFixed(2),
        r.status,
        r.aiConfidence || 98
      ];
      csvRows.push(row.join(','));
    });
    
    const csvString = csvRows.join('\n');
    const blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
    const url = URL.createObjectURL(blob);
    const link = document.createElement('a');
    link.setAttribute('href', url);
    link.setAttribute('download', `Laporan_Resit_${timeFilter}_${today.toISOString().split('T')[0]}.csv`);
    link.style.visibility = 'hidden';
    document.body.appendChild(link);
    link.click();
    document.body.removeChild(link);
  };

  // --- REUSABLE UI COMPONENTS ---
  const FilterPills = () => (
    <div className="flex space-x-2 overflow-x-auto hide-scrollbar py-1">
      {['semua', 'harian', 'mingguan', 'bulanan', 'tahunan'].map(f => (
        <button 
          key={f}
          onClick={() => setTimeFilter(f)}
          className={`px-4 py-1.5 rounded-full text-xs font-bold capitalize transition-all duration-200 whitespace-nowrap ${timeFilter === f ? 'bg-gradient-to-r from-blue-600 to-indigo-600 text-white shadow-md shadow-blue-500/30 border-transparent' : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 hover:border-slate-300'}`}
        >
          {f}
        </button>
      ))}
    </div>
  );

  // --- RENDERERS ---
  return (
    <div className="min-h-screen bg-slate-50 text-slate-800 font-sans pb-12">
      {/* HEADER */}
      <header className="bg-white border-b border-slate-200 sticky top-0 z-30 shadow-sm">
        <div className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div className="flex justify-between items-center h-16">
            <div className="flex items-center space-x-3">
              <div className="bg-gradient-to-br from-blue-600 to-indigo-600 p-2 rounded-xl shadow-inner shadow-blue-800/20">
                <FileText className="w-6 h-6 text-white" />
              </div>
              <h1 className="text-xl font-extrabold text-slate-900 tracking-tight">AI<span className="text-blue-600">Resit</span></h1>
            </div>
            <nav className="flex space-x-1 overflow-x-auto hide-scrollbar">
              <button onClick={() => setActiveTab('upload')} className={`flex items-center px-4 py-2 rounded-lg text-sm font-medium transition ${activeTab === 'upload' ? 'bg-blue-50 text-blue-700' : 'text-slate-500 hover:bg-slate-100'}`}>
                <Upload className="w-4 h-4 mr-2" /> Muat Naik
              </button>
              <button onClick={() => setActiveTab('dashboard')} className={`flex items-center px-4 py-2 rounded-lg text-sm font-medium transition ${activeTab === 'dashboard' ? 'bg-blue-50 text-blue-700' : 'text-slate-500 hover:bg-slate-100'}`}>
                <BarChart3 className="w-4 h-4 mr-2" /> Papan Pemuka
              </button>
              <button onClick={() => setActiveTab('list')} className={`flex items-center px-4 py-2 rounded-lg text-sm font-medium transition ${activeTab === 'list' ? 'bg-blue-50 text-blue-700' : 'text-slate-500 hover:bg-slate-100'}`}>
                <Database className="w-4 h-4 mr-2" /> Senarai
              </button>
              <button onClick={() => setActiveTab('settings')} className={`flex items-center px-4 py-2 rounded-lg text-sm font-medium transition ${activeTab === 'settings' ? 'bg-blue-50 text-blue-700' : 'text-slate-500 hover:bg-slate-100'}`}>
                <Settings className="w-4 h-4 mr-2" /> Tetapan
              </button>
            </nav>
          </div>
        </div>
      </header>

      {/* MAIN CONTENT */}
      <main className="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8">
        
        {/* TAB: UPLOAD */}
        {activeTab === 'upload' && (
          <div className="max-w-3xl mx-auto bg-white rounded-2xl border border-slate-200 shadow-sm p-6 sm:p-8">
            <h2 className="text-2xl font-bold text-slate-900 mb-6 flex items-center">
              <ImageIcon className="w-6 h-6 mr-3 text-blue-600" /> Muat Naik Resit Baru
            </h2>

            {!selectedFile ? (
              <div className="border-2 border-dashed border-slate-300 rounded-xl p-12 text-center hover:bg-slate-50 transition cursor-pointer"
                   onClick={() => document.getElementById('file-upload').click()}>
                <Upload className="w-12 h-12 text-slate-400 mx-auto mb-4" />
                <p className="text-slate-600 font-medium">Klik atau seret gambar resit ke sini</p>
                <p className="text-sm text-slate-400 mt-2">Sokongan: JPG, PNG, WebP (Max 5MB)</p>
                <input id="file-upload" type="file" accept="image/*" className="hidden" onChange={(e) => handleFileChange(e.target.files[0])} />
              </div>
            ) : (
              <div className="grid grid-cols-1 md:grid-cols-2 gap-8">
                {/* PREVIEW */}
                <div className="space-y-4">
                  <div className="relative rounded-xl overflow-hidden border border-slate-200 bg-slate-900 flex items-center justify-center h-[400px]">
                    <img src={previewUrl} alt="Preview" className="h-full object-contain p-2" />
                    {isScanning && (
                      <div className="absolute inset-0 bg-blue-900/30">
                        <div className="absolute top-0 left-0 right-0 h-1 bg-blue-400 shadow-[0_0_15px_rgba(96,165,250,1)] animate-[scan_2s_ease-in-out_infinite]" />
                      </div>
                    )}
                  </div>
                  <button onClick={() => { setSelectedFile(null); setExtractedData(null); }} className="w-full py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-medium rounded-lg text-sm transition">
                    Tukar Gambar
                  </button>
                </div>

                {/* FORM */}
                <div className="space-y-6">
                  {isScanning ? (
                    <div className="h-full flex flex-col items-center justify-center space-y-4 text-slate-500 py-12">
                      <Loader2 className="w-8 h-8 animate-spin text-blue-600" />
                      <p className="text-sm font-medium animate-pulse">AI sedang mengekstrak data...</p>
                    </div>
                  ) : extractedData ? (
                    <form onSubmit={handleSaveReceipt} className="space-y-4 bg-slate-50 p-5 rounded-xl border border-slate-200">
                      <div>
                        <label className="block text-xs font-semibold text-slate-600 mb-1">Nama Kedai</label>
                        <div className="relative">
                          <Store className="absolute left-3 top-2.5 w-4 h-4 text-slate-400" />
                          <input type="text" required value={extractedData.store} onChange={e => setExtractedData({...extractedData, store: e.target.value})} className="w-full pl-9 pr-3 py-2 bg-white border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" />
                        </div>
                      </div>
                      <div className="grid grid-cols-2 gap-4">
                        <div>
                          <label className="block text-xs font-semibold text-slate-600 mb-1">Tarikh</label>
                          <div className="relative">
                            <Calendar className="absolute left-3 top-2.5 w-4 h-4 text-slate-400" />
                            <input type="date" required value={extractedData.date} onChange={e => setExtractedData({...extractedData, date: e.target.value})} className="w-full pl-9 pr-3 py-2 bg-white border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500" />
                          </div>
                        </div>
                        <div>
                          <label className="block text-xs font-semibold text-slate-600 mb-1">Jumlah (RM)</label>
                          <div className="relative">
                            <DollarSign className="absolute left-3 top-2.5 w-4 h-4 text-slate-400" />
                            <input type="number" step="0.01" required value={extractedData.amount} onChange={e => setExtractedData({...extractedData, amount: e.target.value})} className="w-full pl-9 pr-3 py-2 bg-white border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500 font-bold" />
                          </div>
                        </div>
                      </div>
                      <div>
                        <label className="block text-xs font-semibold text-slate-600 mb-1">Kategori</label>
                        <select value={extractedData.category} onChange={e => setExtractedData({...extractedData, category: e.target.value})} className="w-full px-3 py-2 bg-white border border-slate-300 rounded-lg text-sm focus:ring-2 focus:ring-blue-500">
                          {Object.keys(CATEGORY_COLORS).map(cat => <option key={cat} value={cat}>{cat}</option>)}
                        </select>
                      </div>

                      {uploadSuccessMsg && (
                        <div className="p-3 bg-emerald-50 text-emerald-700 text-sm font-medium rounded-lg flex items-center">
                          <CheckCircle2 className="w-4 h-4 mr-2" /> {uploadSuccessMsg}
                        </div>
                      )}

                      <button type="submit" disabled={isSubmitting} className="w-full py-2.5 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-lg shadow-sm transition flex items-center justify-center">
                        {isSubmitting ? <Loader2 className="w-5 h-5 animate-spin" /> : <><Check className="w-5 h-5 mr-2" /> Simpan Data & Gambar</>}
                      </button>
                    </form>
                  ) : null}
                </div>
              </div>
            )}
          </div>
        )}

        {/* TAB: DASHBOARD */}
        {activeTab === 'dashboard' && (
          <div className="space-y-6">
            
            {/* TABS FOR TIME FILTER IN DASHBOARD */}
            <div className="flex flex-col sm:flex-row items-start sm:items-center justify-between bg-white p-4 rounded-2xl border border-slate-200 shadow-sm gap-4">
              <div className="flex items-center text-slate-700 font-semibold text-sm">
                <Calendar className="w-5 h-5 mr-2 text-indigo-500"/> Penapis Data:
              </div>
              <FilterPills />
            </div>

            <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
              <div className="bg-gradient-to-br from-white to-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4 transition hover:shadow-md">
                <div className="p-3 bg-blue-100/80 text-blue-600 rounded-xl"><DollarSign className="w-6 h-6" /></div>
                <div><p className="text-sm font-medium text-slate-500">Jumlah Perbelanjaan</p><p className="text-2xl font-bold text-slate-900">RM {totalAmount.toFixed(2)}</p></div>
              </div>
              <div className="bg-gradient-to-br from-white to-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4 transition hover:shadow-md">
                <div className="p-3 bg-emerald-100/80 text-emerald-600 rounded-xl"><FileText className="w-6 h-6" /></div>
                <div><p className="text-sm font-medium text-slate-500">Jumlah Resit</p><p className="text-2xl font-bold text-slate-900">{filteredReceipts.length}</p></div>
              </div>
              <div className="bg-gradient-to-br from-white to-slate-50 p-6 rounded-2xl border border-slate-200 shadow-sm flex items-center space-x-4 transition hover:shadow-md">
                <div className="p-3 bg-purple-100/80 text-purple-600 rounded-xl"><PieIcon className="w-6 h-6" /></div>
                <div><p className="text-sm font-medium text-slate-500">Purata Transaksi</p><p className="text-2xl font-bold text-slate-900">RM {(filteredReceipts.length ? totalAmount / filteredReceipts.length : 0).toFixed(2)}</p></div>
              </div>
            </div>

            <div className="grid grid-cols-1 lg:grid-cols-2 gap-6">
              <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm">
                <h3 className="text-lg font-bold text-slate-800 mb-6 flex items-center"><PieIcon className="w-5 h-5 mr-2 text-indigo-500"/> Pecahan Kategori</h3>
                <div className="h-64">
                  <ResponsiveContainer width="100%" height="100%">
                    <PieChart>
                      <Pie
                        data={pieData}
                        cx="50%"
                        cy="50%"
                        innerRadius={60}
                        outerRadius={80}
                        paddingAngle={5}
                        dataKey="value"
                      >
                        {pieData.map((entry, index) => (
                          <Cell key={`cell-${index}`} fill={CATEGORY_COLORS[entry.name] || '#64748b'} />
                        ))}
                      </Pie>
                      <RechartsTooltip formatter={(value) => `RM ${Number(value).toFixed(2)}`} />
                    </PieChart>
                  </ResponsiveContainer>
                </div>
              </div>
              
              <div className="bg-white p-6 rounded-2xl border border-slate-200 shadow-sm flex flex-col">
                <h3 className="text-lg font-bold text-slate-800 mb-6 flex items-center"><BarChart3 className="w-5 h-5 mr-2 text-indigo-500"/> Carta Perbelanjaan (Simulasi)</h3>
                <div className="flex-1 min-h-[300px] flex items-center justify-center text-slate-400 bg-slate-50 rounded-xl border border-slate-100">
                   <p className="text-sm">Carta aliran data berfungsi apabila data sejarah mencukupi.</p>
                </div>
              </div>
            </div>
          </div>
        )}

        {/* TAB: LIST */}
        {activeTab === 'list' && (
          <div className="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden flex flex-col">
            <div className="p-6 border-b border-slate-200 bg-gradient-to-br from-slate-50 to-white flex flex-col space-y-4">
              <div className="flex flex-col sm:flex-row justify-between items-start sm:items-center space-y-4 sm:space-y-0">
                <h2 className="text-lg font-bold text-slate-900">Senarai Resit Disahkan</h2>
                <div className="flex w-full sm:w-auto space-x-3">
                  <div className="relative flex-1 sm:w-64">
                    <Search className="absolute left-3 top-2.5 w-4 h-4 text-slate-400" />
                    <input type="text" placeholder="Cari kedai atau kategori..." value={searchTerm} onChange={(e) => setSearchTerm(e.target.value)} className="w-full pl-9 pr-4 py-2 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-indigo-500 bg-white shadow-sm" />
                  </div>
                  <button onClick={handleExportCSV} className="inline-flex items-center px-4 py-2 bg-emerald-50 hover:bg-emerald-100 text-emerald-700 text-sm font-semibold rounded-xl border border-emerald-200 transition shadow-sm whitespace-nowrap">
                    <Download className="w-4 h-4 mr-2" /> Eksport CSV
                  </button>
                </div>
              </div>
              <div className="pt-2">
                <FilterPills />
              </div>
            </div>

            <div className="overflow-x-auto">
              <table className="w-full text-left border-collapse text-sm">
                <thead>
                  <tr className="bg-white border-b border-slate-200 text-slate-500 uppercase text-xs">
                    <th className="py-4 px-6 font-semibold">Tarikh</th>
                    <th className="py-4 px-6 font-semibold">Kedai</th>
                    <th className="py-4 px-6 font-semibold">Kategori</th>
                    <th className="py-4 px-6 font-semibold text-right">Jumlah (RM)</th>
                    <th className="py-4 px-6 font-semibold text-center">Tindakan</th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-100">
                  {filteredReceipts.map((r) => (
                    <tr key={r.id} className="hover:bg-indigo-50/50 transition border-b border-slate-50 last:border-0">
                      <td className="py-4 px-6 text-slate-600 whitespace-nowrap">{r.date} <span className="text-xs text-slate-400 ml-1">{r.time}</span></td>
                      <td className="py-4 px-6 font-bold text-slate-900">{r.store}</td>
                      <td className="py-4 px-6">
                        <span className="px-2.5 py-1 rounded-full text-[10px] font-bold text-white shadow-sm" style={{ backgroundColor: CATEGORY_COLORS[r.category] || '#64748b' }}>
                          {r.category}
                        </span>
                      </td>
                      <td className="py-4 px-6 font-extrabold text-slate-900 text-right">RM {r.amount.toFixed(2)}</td>
                      <td className="py-4 px-6 text-center">
                        <button onClick={() => setSelectedReceiptDetail(r)} className="inline-flex items-center px-3 py-1.5 bg-blue-50 hover:bg-blue-100 text-blue-700 text-xs font-semibold rounded-lg border border-blue-200 transition">
                          <ImageIcon className="w-3.5 h-3.5 mr-1.5" /> Lihat Bukti
                        </button>
                      </td>
                    </tr>
                  ))}
                  {filteredReceipts.length === 0 && (
                    <tr>
                      <td colSpan="5" className="py-12 text-center text-slate-500">Tiada resit dijumpai.</td>
                    </tr>
                  )}
                </tbody>
              </table>
            </div>
          </div>
        )}

        {/* TAB: SETTINGS */}
        {activeTab === 'settings' && (
          <div className="bg-white rounded-2xl border border-slate-200 p-8 shadow-sm">
            <h2 className="text-xl font-bold text-slate-900 mb-4 flex items-center">
              <Database className="w-6 h-6 mr-3 text-blue-600" /> Tetapan Google Apps Script (Drive & Sheets)
            </h2>
            <p className="text-sm text-slate-600 mb-6">
              Sistem ini dibina untuk diintegrasikan terus dengan ekosistem Google Workspace anda. Untuk menyimpan fail resit fizikal terus ke Google Drive anda secara rasmi, masukkan Web App URL di bawah.
            </p>

            <div className="mb-8">
              <label className="block text-sm font-semibold text-slate-700 mb-2">Web App URL (Google Apps Script)</label>
              <input type="text" placeholder="https://script.google.com/macros/s/.../exec" value={scriptUrl} onChange={(e) => setScriptUrl(e.target.value)} className="w-full px-4 py-3 bg-slate-50 border border-slate-300 rounded-xl text-sm focus:ring-2 focus:ring-blue-500" />
            </div>

            <div className="bg-slate-900 rounded-xl overflow-hidden shadow-inner">
              <div className="px-4 py-2 bg-slate-800 border-b border-slate-700 flex justify-between items-center">
                <span className="text-xs font-mono text-slate-300">Code.gs</span>
              </div>
              <pre className="p-4 text-xs font-mono text-emerald-400 overflow-x-auto">
                {GOOGLE_APPS_SCRIPT_CODE}
              </pre>
            </div>
          </div>
        )}
      </main>

      {/* MODAL: BUKTI RESIT */}
      {selectedReceiptDetail && (
        <div className="fixed inset-0 bg-slate-900/80 backdrop-blur-sm z-50 flex items-center justify-center p-4">
          <div className="bg-white rounded-2xl max-w-3xl w-full p-6 shadow-2xl relative">
            <button onClick={() => setSelectedReceiptDetail(null)} className="absolute top-4 right-4 bg-slate-100 hover:bg-slate-200 text-slate-600 p-2 rounded-full transition">
              <X className="w-4 h-4" />
            </button>

            <h3 className="text-lg font-bold text-slate-900 mb-4 flex items-center">
              <ImageIcon className="w-5 h-5 mr-2 text-blue-600" /> Bukti Pembelian: {selectedReceiptDetail.store}
            </h3>

            <div className="grid grid-cols-1 md:grid-cols-2 gap-6">
              <div className="bg-slate-950 rounded-xl overflow-hidden flex items-center justify-center min-h-[300px] relative">
                {selectedReceiptDetail.imageUrl ? (
                  <img src={selectedReceiptDetail.imageUrl} alt="Resit" className="w-full h-full object-contain p-2" />
                ) : (
                  <span className="text-slate-500 text-sm">Tiada Imej Disimpan</span>
                )}
                <a href={selectedReceiptDetail.imageUrl || '#'} target="_blank" rel="noreferrer" className="absolute bottom-3 right-3 bg-slate-900/80 hover:bg-slate-900 text-white text-xs px-3 py-1.5 rounded-lg border border-slate-700 flex items-center shadow-lg transition">
                  <ZoomIn className="w-3.5 h-3.5 mr-1" /> Saiz Penuh
                </a>
              </div>

              <div className="bg-slate-50 p-5 rounded-xl border border-slate-200 space-y-4">
                <div className="grid grid-cols-2 gap-4 text-sm">
                  <div><span className="block text-slate-500 text-xs mb-1">Tarikh</span><span className="font-semibold text-slate-900">{selectedReceiptDetail.date}</span></div>
                  <div><span className="block text-slate-500 text-xs mb-1">Waktu</span><span className="font-semibold text-slate-900">{selectedReceiptDetail.time}</span></div>
                </div>
                <div>
                  <span className="block text-slate-500 text-xs mb-1">Kategori</span>
                  <span className="inline-block px-2.5 py-1 rounded text-xs font-bold text-white" style={{ backgroundColor: CATEGORY_COLORS[selectedReceiptDetail.category] || '#64748b' }}>
                    {selectedReceiptDetail.category}
                  </span>
                </div>
                <div>
                  <span className="block text-slate-500 text-xs mb-1">Status AI</span>
                  <span className="inline-flex items-center text-emerald-600 font-semibold text-sm">
                    <CheckCircle2 className="w-4 h-4 mr-1.5" /> Disahkan ({selectedReceiptDetail.aiConfidence || 98}%)
                  </span>
                </div>
                <div className="pt-4 border-t border-slate-200">
                  <span className="block text-slate-500 text-xs mb-1">Jumlah</span>
                  <span className="text-3xl font-extrabold text-slate-900">RM {selectedReceiptDetail.amount.toFixed(2)}</span>
                </div>
              </div>
            </div>
          </div>
        </div>
      )}
      
      {/* CSS untuk animasi scan */}
      <style>{`
        @keyframes scan {
          0%, 100% { top: 0; }
          50% { top: 100%; }
        }
      `}</style>
    </div>
  );
}
